# ------------------------------------------------------------------
# GAIA — configuration locale (copier vers .env)
# ------------------------------------------------------------------

# Ports des services
INGESTION_PORT=8081
SCENARIO_PORT=8082
AI_PORT=8090
WORLD_BRAIN_PORT=4200
PORTAL_PORT=3000

# Kafka
KAFKA_BROKERS=localhost:9093
KAFKA_TOPIC_EVENTS=gaia.sim.events
KAFKA_TOPIC_AGGREGATES=gaia.sim.aggregates
KAFKA_TOPIC_ALERTS=gaia.sim.alerts

# Bases de données
POSTGRES_JDBC=jdbc:postgresql://localhost:55432/gaia
POSTGRES_USER=gaia
POSTGRES_PASSWORD=gaia_dev
MONGO_URI=mongodb://localhost:27018/gaia
REDIS_HOST=localhost
REDIS_PORT=56379

# Streaming (Flink)
FLINK_APP_NAME=gaia-streaming-aggregator

# Simulation
SIM_DEFAULT_STEP_MS=50
SIM_MAX_ENTITIES=1000000