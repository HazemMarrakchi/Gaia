# ------------------------------------------------------------------
# GAIA — configuration locale (copier vers .env)
# ------------------------------------------------------------------

# Ports des services
INGESTION_PORT=8181
SCENARIO_PORT=8282
AI_PORT=8091
WORLD_BRAIN_PORT=4302
PORTAL_PORT=3000

# Kafka
KAFKA_BROKERS=localhost:9093
KAFKA_TOPIC_EVENTS=gaia.sim.events
KAFKA_TOPIC_AGGREGATES=gaia.sim.aggregates
KAFKA_TOPIC_ALERTS=gaia.sim.alerts

# Bases de données
POSTGRES_JDBC=jdbc:postgresql://localhost:55432/gaia
POSTGRES_USER=gaia
POSTGRES_PASSWORD=gaia_dev
MONGO_URI=mongodb://localhost:27018/gaia
REDIS_HOST=localhost
REDIS_PORT=56379

# Streaming (Flink)
FLINK_APP_NAME=gaia-streaming-aggregator
GAIA_WINDOW_MS=300000
GAIA_SLIDE_MS=60000

# Frontends (URLs consommées par le portal Nuxt)
INGESTION_URL=http://localhost:8181
AI_URL=http://localhost:8091
WORLD_BRAIN_URL=http://localhost:4302

# Simulation
SIM_DEFAULT_STEP_MS=50
SIM_MAX_ENTITIES=1000000